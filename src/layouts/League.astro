---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import { season } from '../lib/league';
import '../styles/league.css';
interface Props { title: string; description?: string; heading?: string; lead?: string; eyebrow?: string; home?: boolean }
const site = { name: 'Riverbend Youth Soccer', phone: '(555) 010-0166', email: 'play@riverbend-soccer.example' };
const nav = [
  { href: '/schedule', label: 'Schedule' },
  { href: '/standings', label: 'Standings' },
  { href: '/teams', label: 'Teams' },
  { href: '/fields', label: 'Fields' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/about', label: 'About' },
];
const { title, description = `${title}: ${site.name}, a fictional youth soccer league.`, heading, lead, eyebrow, home = false } = Astro.props;
const path = Astro.url.pathname;
---
<Base title={title} description={description} siteName={site.name}>
  <div slot="header" class="site-head">
    <div class="wrap bar">
      <a class="brand" href="/"><Logo /><span class="brand-text"><span class="brand-name">Riverbend</span><span class="brand-sub">Youth Soccer</span></span></a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a class="cta" href="/register" aria-current={path.startsWith('/register') ? 'page' : undefined}>Register</a></li>
        </ul>
      </nav>
    </div>
  </div>
  {!home && heading && (
    <div class="page-head">
      <div class="wrap">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{heading}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
    </div>
  )}
  <slot />
  <div slot="footer" class="site-foot">
    <div class="wrap foot">
      <div>
        <p class="foot-brand"><Logo /> {site.name}</p>
        <p>{season} · Every kid plays.</p>
      </div>
      <div>
        <p><a href={`mailto:${site.email}`}>{site.email}</a><br />{site.phone}</p>
        <p><a href="/contact">Contact</a> · <a href="/register">Register</a> · <a href="/accessibility">Accessibility statement</a></p>
      </div>
    </div>
  </div>
</Base>
