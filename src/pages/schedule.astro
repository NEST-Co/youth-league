---
import League from '../layouts/League.astro';
import LeagueBoard from '../components/LeagueBoard.tsx';
import { divisions } from '../lib/league';
---
<League title="Schedule" description="Game schedule and results for every division." eyebrow="Matchday" heading="Schedule and results" lead="Pick a division and a team. Add every game to your calendar.">
  <div class="wrap body">
    <LeagueBoard client:load mode="schedule" />
    <noscript><p>Pick a division to see its calendar file instead.</p></noscript>
    <h2 style="color:var(--navy);margin-top:3rem">Add to your calendar</h2>
    <p>Each file has every game for one division. Open it in your calendar app.</p>
    <ul class="card-grid" style="max-width:820px">{divisions.map((d) => <li><a class="panel" style="display:block;font-weight:800;text-decoration:none" href={`/calendar/${d.id}.ics`}>{d.label} calendar file (.ics)</a></li>)}</ul>
  </div>
</League>
