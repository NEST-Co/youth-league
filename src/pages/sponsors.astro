---
import League from '../layouts/League.astro';
const sponsors = [
  { name: 'Hartwell Hardware', note: 'Jerseys for the Under 8 division' },
  { name: 'Corner Table Diner', note: 'Post-game orange slices and the end-of-season party' },
  { name: 'Lindqvist Dental', note: 'Under 10 equipment' },
  { name: 'Riverbend Credit Union', note: 'Field maintenance fund' },
];
---
<League title="Sponsors" description="Local businesses that support Riverbend Youth Soccer.">
  <div class="wrap">
    <h1>Our sponsors</h1>
    <p>These fictional businesses stand in for the local sponsors a real league would thank here.</p>
    <h2>Thank you to</h2>
    <ul class="cards">{sponsors.map((s) => <li><h3>{s.name}</h3><p>{s.note}</p></li>)}</ul>
    <h2>Become a sponsor</h2>
    <p>Sponsorship supports equipment, fields and financial help for families. <a href="/contact">Contact the league.</a></p>
  </div>
</League>
