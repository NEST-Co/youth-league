---
import League from '../layouts/League.astro';
import { fieldInfo, closures, fmtDate } from '../lib/league';
---
<League title="Fields" description="Where we play, with directions and current closures." eyebrow="Game day" heading="Fields" lead="Where we play, how to find us, and what to bring.">
  <div class="wrap body">
    {closures.map((c) => <div class="alert" style="margin-top:0;margin-bottom:2rem" role="region" aria-label="Field closure"><span class="ico" aria-hidden="true">!</span><p><strong>{fmtDate(c.date)}:</strong> {c.field}. {c.reason}</p></div>)}
    <div class="two">
      <div>
        <h2 style="margin-top:0;color:var(--navy)">Where we play</h2>
        <ul class="value-list">{fieldInfo.map((f, i) => <li><span class="n" aria-hidden="true">{i + 1}</span><span><b>{f.name}</b>{f.address}. {f.note}</span></li>)}</ul>
      </div>
      <div>
        <img class="photo" src="/img/field-map.png" alt="Illustrated map of Riverbend Park: parking, a snack stand, a playground and two fields beside the creek, with Field 2 marked closed" width="800" height="520" />
        <p class="meta" style="color:var(--muted);font-size:.9rem;margin:.5rem 0 0">Illustration, not to scale.</p>
      </div>
    </div>
    <h2 style="color:var(--navy);margin-top:3rem">Game day basics</h2>
    <ul class="steps">
      <li><h3>Arrive early</h3><p>Get there 15 minutes before kickoff.</p></li>
      <li><h3>Pack the basics</h3><p>Bring water. Shin guards are required.</p></li>
      <li><h3>Weather calls</h3><p>If we cancel for weather, the schedule page and a note on this site are updated by 7 a.m.</p></li>
    </ul>
  </div>
</League>
