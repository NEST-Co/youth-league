---
import League from '../layouts/League.astro';
---
<League title="About" description="About Riverbend Youth Soccer." eyebrow="Who we are" heading="About the league" lead="Riverbend Youth Soccer is a fictional league created to show Nest Co.'s website work. The details here are invented.">
  <div class="wrap body">
    <ul class="value-list" style="max-width:var(--measure)">
      <li><span class="n" aria-hidden="true">1</span><span><b>What we believe</b>Every kid gets to play. Everyone plays at least half of every game, and standings matter less than showing up and having fun.</span></li>
      <li><span class="n" aria-hidden="true">2</span><span><b>Safety</b>All coaches complete a background check and a short safety course. We follow a concussion protocol and a lightning rule: when thunder is heard, everyone leaves the field.</span></li>
    </ul>
  </div>
</League>
