---
import League from '../layouts/League.astro';
---
<League title="Register" description="How to register for spring soccer, fees and financial help." eyebrow="Spring season" heading="Register for spring" lead="Registration opens January 5 and closes February 15. This is a concept site, so there is no real sign-up form.">
  <div class="wrap body">
    <div class="price">
      <b>$60</b>
      <p><strong style="color:#fff">Per player, jersey and socks included.</strong> Families with more than one player pay for the first two only. No child is turned away because of cost: ask the registrar, and you will not be asked why.</p>
    </div>
    <h2 style="color:var(--navy);margin-top:0">Three steps</h2>
    <ol class="steps">
      <li><h3>Check the age</h3><p>Children ages 5 to 12 by August 1 of the season year. Divisions are Under 8, Under 10 and Under 12.</p></li>
      <li><h3>Gather your info</h3><p>Your child's name and birth date, a parent or guardian's phone and email, and any health or access needs we should know about.</p></li>
      <li><h3>Sign up</h3><p>Registration opens January 5 and closes February 15.</p></li>
    </ol>
    <div class="panel" style="max-width:var(--measure)"><h3>Volunteer</h3><p style="margin:0">We always need coaches, referees and snack-stand help. No experience is needed, and we will train you.</p></div>
  </div>
</League>
